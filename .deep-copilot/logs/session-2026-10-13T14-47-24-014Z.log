[2026-10-13T14:51:10.556Z] [TOOL_RESULT] {"id":"call_01_pGKgNWerk7KjzX09gXSN3819","name":"read_file","elapsed_ms":1,"ok":true,"output":"#!/bin/bash\n#\n# Build the OpenQOS RPMs and publish them as an rpm-md repository.\n#\n# Run inside the Fedora development VM:\n#\n#   scripts/build-packages.sh\n#   scripts/build-packages.sh --clean\n#\n# The builds themselves run as whoever invokes the script, not as root: only the\n# publish step needs write access to the repository directory, and building as\n# root bakes root ownership into the package payload.\n#\n# Published to /srv/openqos/packages, which is the path referenced by the\n# <repository> entry in kiwi/openqos/base.xml. A repository source has to be an\n# absolute URI, so the two locations are written down in two places by necessity\n# and this comment is the link between them.\n\nset -euo pipefail\n\nscript_dir=\"$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)\"\nrepo_root=\"$(cd -- \"${script_dir}/..\" && pwd)\"\npublish_dir=\"/srv/openqos/packages\"\n\n# The build tree lives on the virtual machine's own disk, not in the repository.\n# This is not tidiness. The repository is a mount from the macOS host, and\n# rpmbuild writing into it through that mount loses the executable bit: packages\n# built in packages/_build came out with mode 0600 for every file produced by\n# `install -m 0755`, silently, with no error from rpmbuild — which for this\n# repository means a launcher and a systemd ExecStart that cannot run. Moving the\n# build tree here produces the modes the spec asks for. It is the same constraint\n# the image build documents for KIWI's target directory.\n#\n# OPENQOS_PACKAGE_BUILD_ROOT overrides the location for a build on a host where\n# the repository is a normal filesystem.\nbuild_root=\"${OPENQOS_PACKAGE_BUILD_ROOT:-/var/tmp/openqos-packages}\"\n\nusage() {\n\tcat >&2 <<-'EOF'\n\t\tusage: scripts/build-packages.sh [--clean]\n\n\t\t  --clean   Start from an empty build tree instead of reusing it\n\t\t  -h, --help\n\tEOF\n}\n\nclean=false\nfor arg in \"$@\"; do\n\tcase \"${arg}\" in\n\t\t--clean) clean=true ;;\n\t\t-h | --help) usage; exit 0 ;;\n\t\t*) echo \"error: unknown argument: ${arg}\" >&2; usage; exit 2 "}
[2026-10-13T14:51:10.556Z] [TOOL_RESULT] {"id":"call_02_7S1UqrDQsZlGzVDxSrAY5879","name":"read_file","elapsed_ms":1,"ok":true,"output":"#!/bin/bash\n#\n# Materialise Fedora's KIWI image descriptions at the revision pinned in\n# kiwi/upstream.lock, into kiwi/upstream/.\n#\n# OpenQOS does not vendor Fedora's descriptions into this repository. They are\n# fetched at a pinned revision instead, so that:\n#   * the delta between Fedora's description and ours stays visible in review,\n#   * upstream fixes are taken deliberately rather than by silently drifting,\n#   * builds stay reproducible, because the revision is pinned by commit SHA.\n#\n# The output directory is gitignored. Run this before building an image.\n#\n# Runs inside the Fedora development VM (see docs/development-environment.md).\n# Requires: git.\n#\n# Usage:\n#   scripts/fetch-upstream-descriptions.sh\n#   scripts/fetch-upstream-descriptions.sh --update-lock\n\nset -euo pipefail\n\nscript_dir=\"$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)\"\nrepo_root=\"$(cd -- \"${script_dir}/..\" && pwd)\"\nlock_file=\"${repo_root}/kiwi/upstream.lock\"\ndest_dir=\"${repo_root}/kiwi/upstream\"\nupstream_url=\"https://forge.fedoraproject.org/releng/kiwi-descriptions.git\"\n\nusage() {\n\tcat >&2 <<-EOF\n\t\tusage: $(basename -- \"$0\") [--update-lock]\n\n\t\t  (no options)   fetch the pinned revision into kiwi/upstream\n\t\t  --update-lock  move the pin to the current head of the recorded branch\n\tEOF\n}\n\n# Read a single key from the lock file without executing it.\nlock_value() {\n\tsed -n \"s/^$1=//p\" \"${lock_file}\" | head -n1\n}\n\nupdate_lock=false\nfor arg in \"$@\"; do\n\tcase \"${arg}\" in\n\t\t--update-lock) update_lock=true ;;\n\t\t-h|--help) usage; exit 0 ;;\n\t\t*) echo \"error: unknown argument: ${arg}\" >&2; usage; exit 2 ;;\n\tesac\ndone\n\nif [[ ! -f \"${lock_file}\" ]]; then\n\techo \"error: lock file not found: ${lock_file}\" >&2\n\texit 1\nfi\n\nbranch=\"$(lock_value upstream_branch)\"\ncommit=\"$(lock_value upstream_commit)\"\nrelease=\"$(lock_value fedora_release)\"\n\nif [[ -z \"${branch}\" || -z \"${commit}\" ]]; then\n\techo \"error: ${lock_file} must set upstream_branch and upstream_commit\" >&2\n\texit 1\nfi\n\nif [[ -d \"${dest_dir}/.git\" ]]"}
