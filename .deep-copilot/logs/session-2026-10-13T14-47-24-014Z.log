timeout-seconds]\" >&2\n\texit 2\nfi\n\nimage=\"$1\"\ntimeout_seconds=\"${2:-1800}\"\nwork=\"${WORK:-/var/tmp/openqos-screenshot}\"\n# A host port forward lets you SSH into the guest for diagnost"}
