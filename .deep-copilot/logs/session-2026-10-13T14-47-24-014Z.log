[2026-10-13T16:34:50.362Z] [TOOL_CALL] {"id":"call_00_nKGgli1FQgoGLvnvzq1o2828","name":"write_file","args":{"content":"#!/usr/bin/env python3\n\"\"\"Boot an OpenQOS x86_64 artefact under QEMU and decide whether it draws a\ngraphical session.\n\nHandles both artefacts: a qcow2 disk image (attached as a virtio disk) and a live\nISO (attached as a CD-ROM, booted from). Progress is judged from the framebuffer\nvia QEMU's monitor screendump, not the serial console, because systemd stops\nlogging to serial once the console moves and a graphical greeter writes nothing\nthere at all.\n\n\"Graphical\" is decided by content, not file size: a P6 PPM is width*height*3 bytes\nwhether it holds a wallpaper or one flat colour, so only the compressed size of\nthe pixel payload distinguishes blank from console text from a drawn session.\n\"\"\"\nimport atexit\nimport os\nimport shutil\nimport socket\nimport subprocess\nimport sys\nimport time\nimport zlib\n\nIMG = sys.argv[1]\nDEADLINE = int(sys.argv[2]) if len(sys.argv) > 2 else 420\nWANT = int(sys.argv[3]) if len(sys.argv) > 3 else 2\n\nWORK = \"/var/tmp/openqos-gfxcheck\"\nOVMF_CODE = \"/usr/share/OVMF/OVMF_CODE_4M.fd\"\nOVMF_VARS = \"/usr/share/OVMF/OVMF_VARS_4M.fd\"\nVNC_PORT = 12\n\nMON = os.path.join(WORK, \"monitor.sock\")\nSHOTS = os.path.join(WORK, \"shots\")\n\nshutil.rmtree(WORK, ignore_errors=True)\nos.makedirs(SHOTS)\nshutil.copy(OVMF_VARS, os.path.join(WORK, \"vars.fd\"))\n\ncmd = [\n    \"qemu-system-x86_64\",\n    \"-machine\", \"q35,accel=kvm\",\n    \"-cpu\", \"host\",\n    \"-smp\", \"4\",\n    \"-m\", \"4096\",\n    \"-drive\", f\"if=pflash,format=raw,readonly=on,file={OVMF_CODE}\",\n    \"-drive\", f\"if=pflash,format=raw,file={WORK}/vars.fd\",\n]\n\nif IMG.endswith(\".iso\"):\n    # media=cdrom so the guest sees an optical drive, and boot from it explicitly.\n    cmd += [\"-drive\", f\"file={IMG},if=none,id=cd0,media=cdrom,readonly=on\",\n            \"-device\", \"virtio-blk-pci,drive=cd0,bootindex=1\"]\n    kind = \"live ISO\"\nelse:\n    cmd += [\"-drive\", f\"if=virtio,format=qcow2,snapshot=on,file={IMG}\"]\n    kind = \"disk image\"\n\ncmd += [\n    \"-device\", \"virtio-gpu-pci\",\n    \"-device\", \"virtio-keyboard-pci\",\n    \"-device\", \"virtio-tablet-pci\",\n    \"-netdev\", \"user,id=n0\",\n    \"-device\", \"virtio-net-pci,netdev=n0\",\n    \"-vnc\", f\"127.0.0.1:{VNC_PORT}\",\n    \"-serial\", f\"file:{WORK}/serial.log\",\n    \"-monitor\", f\"unix:{MON},server,nowait\",\n    \"-pidfile\", f\"{WORK}/qemu.pid\",\n    \"-daemonize\",\n]\n\nprint(f\"booting {kind}: {IMG}\", flush=True)\nsubprocess.run(cmd, check=True)\npid = int(open(f\"{WORK}/qemu.pid\").read().strip())\nprint(f\"qemu pid {pid}\", flush=True)\n\n\ndef cleanup():\n    subprocess.run([\"kill\", str(pid)], check=False)\n\n\natexit.register(cleanup)\n\n\ndef content_size(path):\n    try:\n        with open(path, \"rb\") as handle:\n            data = handle.read()\n    except OSError:\n        return 0\n    parts = data.split(b\"\\n\", 3)\n    if len(parts) < 4 or parts[0] != b\"P6\":\n        return 0\n    return len(zlib.compress(parts[3], 6))\n\n\nblank_threshold = 5_000\ntext_threshold = 80_000\n\nstart = time.time()\ngraphical = 0\nframes = 0\nwhile time.time() - start < DEADLINE:\n    elapsed = int(time.time() - start)\n    path = os.path.join(SHOTS, f\"screen-{elapsed:04d}.ppm\")\n    try:\n        connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)\n        connection.connect(MON)\n        time.sleep(0.2)\n        connection.recv(65536)\n        connection.sendall(f\"screendump {path}\\n\".encode())\n        time.sleep(2.0)\n        connection.recv(65536)\n        connection.close()\n    except OSError as error:\n        print(f\"[{elapsed:5}s] monitor error: {error}\", flush=True)\n        time.sleep(15)\n        continue\n\n    size = content_size(path)\n    frames += 1\n    if size > text_threshold:\n        graphical += 1\n        print(f\"[{elapsed:5}s] frame {frames}: {size} bytes  <- graphical\", flush=True)\n        if graphical >= WANT:\n            print(\"stopping: enough drawn frames\", flush=True)\n            break\n    elif size > blank_threshold:\n        print(f\"[{elapsed:5}s] frame {frames}: {size} bytes  (console)\", flush=True)\n    else:\n        print(f\"[{elapsed:5}s] frame {frames}: {size} bytes  (blank)\", flush=True)\n    tim…(+300 chars)","path":"/tmp/x86_gfx_check.py"}}
