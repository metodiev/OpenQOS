\" in\n\t\t--profile) profile=\"${2:?--profile needs a value}\"; shift 2 ;;\n\t\t--type) image_type=\"${2:?--type needs a value}\"; shift 2 ;;\n\t\t--output) output_name=\"${2:?--output needs a value}\"; shift 2 ;;\n\t\t--scratch) scratch_root=\"${2:"}
